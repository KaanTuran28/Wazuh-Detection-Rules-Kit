<group name="local,syslog,sshd,">

  <rule id="100010" level="5">
    <if_sid>5716</if_sid>
    <same_source_ip />
    <description>sshd: authentication failed - custom watch.</description>
    <group>authentication_failed,pci_dss_10.2.4,pci_dss_10.2.5,gpg13_7.1,gdpr_IV_35.7.d,hipaa_164.312.b,nist_800_53_AU.14,nist_800_53_AC.7,</group>
  </rule>

  <rule id="100011" level="10" frequency="6" timeframe="120">
    <if_matched_sid>100010</if_matched_sid>
    <description>sshd: multiple authentication failures from same source - possible brute force attack.</description>
    <group>authentication_failures,pci_dss_11.4,pci_dss_10.2.4,pci_dss_10.2.5,gpg13_7.1,gdpr_IV_35.7.d,hipaa_164.312.b,nist_800_53_AU.14,nist_800_53_SI.4,</group>
  </rule>

  <rule id="100012" level="12">
    <if_matched_sid>100011</if_matched_sid>
    <match>Accepted</match>
    <description>sshd: possible successful brute force - failed attempts followed by accepted login.</description>
    <group>authentication_success,pci_dss_10.2.5,pci_dss_11.4,gpg13_7.1,gdpr_IV_35.7.d,hipaa_164.312.b,nist_800_53_AU.14,nist_800_53_SI.4,</group>
  </rule>

</group>
